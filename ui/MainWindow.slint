import { VerticalBox, HorizontalBox } from "std-widgets.slint";

component AppButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <length> btn-width: 0px;
    callback clicked();

    height: 36px;
    width: btn-width > 0px ? btn-width : btn-label.preferred-width + 28px;
    border-radius: 8px;
    background: !enabled ? #2a2b31
              : primary ? #4c8dfd
              : #ffffff14;

    btn-label := Text {
        text: root.label;
        color: !enabled ? #6a6d75 : primary ? #ffffff : #d7d9de;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component TagField inherits Rectangle {
    in property <string> caption;
    in-out property <string> value;
    in property <bool> tall: false;
    callback edited();

    height: tall ? 116px : 62px;
    width: 100%;
    background: transparent;

    Text {
        text: caption;
        color: #9aa0a8;
        font-size: 12px;
    }

    Rectangle {
        y: 24px;
        width: parent.width;
        height: parent.height - 24px;
        border-radius: 10px;
        background: #ffffff0d;
        border-width: input-field.has-focus ? 1.5px : 1px;
        border-color: input-field.has-focus ? #4c8dfd : #ffffff1f;

        input-field := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text <=> root.value;
            color: #e8e9ee;
            font-size: 14px;
            vertical-alignment: root.tall ? top : center;
            wrap: root.tall ? word-wrap : no-wrap;
            single-line: !root.tall;
            edited => {
                root.edited();
            }
        }
    }
}

export component MainWindow inherits Window {
    in-out property <string> file-name;
    in-out property <string> track-title;
    in-out property <string> artist;
    in-out property <string> album;
    in-out property <string> album-artist;
    in-out property <string> genre;
    in-out property <string> date;
    in-out property <string> track;
    in-out property <string> comment;
    in-out property <string> status-message;
    in-out property <string> error-message;
    in-out property <bool> dirty;
    in-out property <bool> has-file;
    in-out property <bool> has-cover-image;
    in-out property <bool> can-remove-cover;
    in-out property <image> cover-image;
    in-out property <bool> show-confirm-close;
    in-out property <string> confirm-close-message;

    callback open-file();
    callback save-file();
    callback set-cover();
    callback remove-cover();
    callback field-edited();
    callback confirm-close-save();
    callback confirm-close-discard();
    callback confirm-close-cancel();
    callback close-requested();

    width: 460px;
    height: 560px;
    title: "Audio Tag Editor";
    background: #17181d;

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 64px;
            background: #17181d;

            HorizontalBox {
                x: 20px;
                y: 12px;
                width: parent.width - 40px;
                height: 40px;
                spacing: 12px;
                padding: 0px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: #4c8dfd;

                    Rectangle { x: 10px; y: 15px; width: 3px; height: 10px; border-radius: 1.5px; background: #ffffff; }
                    Rectangle { x: 16px; y: 10px; width: 3px; height: 20px; border-radius: 1.5px; background: #ffffff; }
                    Rectangle { x: 22px; y: 13px; width: 3px; height: 14px; border-radius: 1.5px; background: #ffffff; }
                    Rectangle { x: 28px; y: 8px;  width: 3px; height: 24px; border-radius: 1.5px; background: #ffffff; }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    padding: 0px;

                    Text {
                        text: root.file-name != "" ? root.file-name : "Audio Tag Editor";
                        color: #f0f1f5;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: root.has-file ? "Ready to edit tags" : "Open a file to edit tags";
                        color: #9aa0a8;
                        font-size: 12px;
                        overflow: elide;
                    }
                }

                AppButton {
                    label: "Open";
                    clicked => { root.open-file(); }
                }

                AppButton {
                    label: root.dirty ? "Save *" : "Save";
                    primary: true;
                    enabled: root.has-file;
                    clicked => { root.save-file(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: #ffffff14;
        }

        VerticalBox {
            vertical-stretch: 1;
            padding: 16px;
            spacing: 10px;

            Rectangle {
                height: 140px;
                border-radius: 12px;
                background: #ffffff0d;
                border-width: 1px;
                border-color: #ffffff1f;

                Image {
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    x: 8px;
                    y: 8px;
                    source: root.cover-image;
                    image-fit: contain;
                    visible: root.has-cover-image;
                }

                Text {
                    text: "No cover";
                    color: #9aa0a8;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                    visible: !root.has-cover-image;
                }
            }

            HorizontalBox {
                spacing: 4px;
                padding: 0px;

                AppButton {
                    label: "Set Cover";
                    enabled: root.has-file;
                    clicked => { root.set-cover(); }
                }
                AppButton {
                    label: "Remove Cover";
                    enabled: root.can-remove-cover;
                    clicked => { root.remove-cover(); }
                }
            }

            TagField {
                caption: "Title";
                value <=> root.track-title;
                edited => { root.field-edited(); }
            }

            TagField {
                caption: "Artist";
                value <=> root.artist;
                edited => { root.field-edited(); }
            }

            TagField {
                caption: "Album";
                value <=> root.album;
                edited => { root.field-edited(); }
            }

            TagField {
                caption: "Album Artist";
                value <=> root.album-artist;
                edited => { root.field-edited(); }
            }

            TagField {
                caption: "Genre";
                value <=> root.genre;
                edited => { root.field-edited(); }
            }

            HorizontalBox {
                spacing: 12px;
                padding: 0px;

                TagField {
                    horizontal-stretch: 1;
                    caption: "Date";
                    value <=> root.date;
                    edited => { root.field-edited(); }
                }
                TagField {
                    horizontal-stretch: 1;
                    caption: "Track";
                    value <=> root.track;
                    edited => { root.field-edited(); }
                }
            }

            TagField {
                caption: "Comment";
                value <=> root.comment;
                tall: true;
                edited => { root.field-edited(); }
            }
        }

        Rectangle {
            height: 36px;
            background: #ffffff08;

            HorizontalBox {
                x: 20px;
                y: 0px;
                width: parent.width - 40px;
                height: parent.height;
                spacing: 8px;
                padding: 0px;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: #4c8dfd;
                    visible: root.dirty;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.status-message;
                    color: #9aa0a8;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Text {
                    text: root.dirty ? "Unsaved changes" : "";
                    color: #4c8dfd;
                    font-size: 12px;
                    visible: root.dirty;
                    vertical-alignment: center;
                }
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        visible: root.error-message != "";

        Rectangle {
            width: 340px;
            height: 150px;
            border-radius: 14px;
            background: #2a2b33;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalBox {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                height: parent.height - 28px;
                spacing: 10px;
                padding: 0px;

                Text {
                    horizontal-stretch: 1;
                    text: root.error-message;
                    color: #e8e9ee;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    spacing: 8px;
                    padding: 0px;

                    Rectangle { horizontal-stretch: 1; }

                    AppButton {
                        label: "OK";
                        primary: true;
                        btn-width: 72px;
                        clicked => { root.error-message = ""; }
                    }
                }
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;
        visible: root.show-confirm-close;

        Rectangle {
            width: 340px;
            height: 160px;
            border-radius: 14px;
            background: #2a2b33;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalBox {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                height: parent.height - 28px;
                spacing: 10px;
                padding: 0px;

                Text {
                    horizontal-stretch: 1;
                    text: root.confirm-close-message;
                    color: #e8e9ee;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    spacing: 8px;
                    padding: 0px;

                    Rectangle { horizontal-stretch: 1; }

                    AppButton {
                        label: "Cancel";
                        btn-width: 72px;
                        clicked => {
                            root.show-confirm-close = false;
                            root.confirm-close-cancel();
                        }
                    }

                    AppButton {
                        label: "Don't Save";
                        btn-width: 88px;
                        clicked => {
                            root.show-confirm-close = false;
                            root.confirm-close-discard();
                        }
                    }

                    AppButton {
                        label: "Save";
                        primary: true;
                        btn-width: 72px;
                        clicked => {
                            root.show-confirm-close = false;
                            root.confirm-close-save();
                        }
                    }
                }
            }
        }
    }
}
